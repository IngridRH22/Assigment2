extends layout.pug

block principal

    h1 Account
    section(class="acountInfo")
        form(action="/updateAccount", method="POST")
            p Username: #{user.username}
            input(type="text", name="username", id="username", required = true, placeholder="Update your username")
            p Email: #{user.email}
            input(type="email", name="email", id="email", required = true, placeholder="Update your email")
            button(type="submit") Update Account

        
        button(type="submit") Logout
        button(type="submit") Delete Account