extends layout.pug

block principal

    div(class="generalS")
        section(class="search")
            h1 Search for movies
            form(action="/searchmovies", method="POST")
                input(type="text", name="searchQuery", id="searchQuery", required = true, placeholder="Search a movie, series or person", value=searchQuery)
                button(type="submit") Search
            if results
                each item in results
                    if item.media_type === "movie" && (mediaType === "movie" || mediaType === undefined)
                        if item.genre_ids.includes(parseInt(genres)) || genres === undefined
                            div(class="movie" onclick="window.location.href='/movie/' + item.id")
                                img(src="https://image.tmdb.org/t/p/w500" + item.poster_path, alt=item.title)
                                h2= item.title
                                p= item.overview
                                button(type="button", onclick=`event.stopPropagation(); addMovieToList('${item.id}', 'movie')`) Add to List
                    else if item.media_type === "tv" && (mediaType === "tv" || mediaType === undefined)
                        if item.genre_ids.includes(parseInt(genres)) || genres === undefined
                            div(class="tv" onclick="window.location.href='/tv/' + item.id")
                                img(src="https://image.tmdb.org/t/p/w500" + item.poster_path, alt=item.name)
                                h2= item.name
                                p= item.overview
                                button(type="button", onclick=`event.stopPropagation(); addMovieToList('${item.id}', 'tv')`) Add to List
                    else if item.media_type === "person"
                       // div(class="person" onclick="window.location.href='/person/' + item.id")
                            img(src="https://image.tmdb.org/t/p/w500" + item.profile_path, alt=item.name)
                            h2= item.name
                            p= item.known_for_department//
        section(class="filters")
          h2 Filters
          form(action="/searchmovies", method="POST")
              input(type="hidden", name="searchQuery", value=searchQuery)
              h3 Filter by Type
              div
                label
                  input(type="checkbox", name="mediaType", value="movie", checked=mediaType && mediaType.includes("movie"))
                  |  Movie
                label
                  input(type="checkbox", name="mediaType", value="tv", checked=mediaType && mediaType.includes("tv"))
                  |  TV Show
              br
              h3 Filter by Genre
              div
                label
                  input(type="checkbox", name="genres", value="28", checked=genres && genres.includes("28"))
                  |  Action
                label
                  input(type="checkbox", name="genres", value="12", checked=genres && genres.includes("12"))
                  |  Adventure
                label
                  input(type="checkbox", name="genres", value="35", checked=genres && genres.includes("35"))
                  |  Comedy
                label
                  input(type="checkbox", name="genres", value="80", checked=genres && genres.includes("80"))
                  |  Crime
                label
                  input(type="checkbox", name="genres", value="14", checked=genres && genres.includes("14"))
                  |  Fantasy
                label
                  input(type="checkbox", name="genres", value="18", checked=genres && genres.includes("18"))
                  |  Drama
                label
                  input(type="checkbox", name="genres", value="10751", checked=genres && genres.includes("10751"))
                  |  Family
                label
                  input(type="checkbox", name="genres", value="53", checked=genres && genres.includes("53"))
                  |  Thriller
                label
                  input(type="checkbox", name="genres", value="10749", checked=genres && genres.includes("10749"))
                  |  Romance
                label
                  input(type="checkbox", name="genres", value="9648", checked=genres && genres.includes("9648"))
                  |  Mystery
                label
                  input(type="checkbox", name="genres", value="878", checked=genres && genres.includes("878"))
                  |  Science Fiction
              button(type="submit") Apply Filters
    script.
        async function addMovieToList(id, mediaType) {
            try {
                console.log("Adding item with ID:", id, "and mediaType:", mediaType);
                const response = await fetch('/addMovieToList', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ id: id, mediaType: mediaType, genres: [genre_ids] })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    alert(data.message);
                } else {
                    alert("Error: " + data.message);
                }
            } catch (error) {
                console.error("Network error:", error);
                alert("Could not connect to the server.");
            }
        }