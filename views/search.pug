extends layout.pug

block principal

    div(class="generalS")
        section(class="search")
            h1 Search for movies
            form(action="/searchmovies", method="POST")
                input(type="text", name="searchQuery", id="searchQuery", required = true, placeholder="Search a movie, series or person", value=searchQuery)
                button(type="submit") Search
            if results
                each item in results
                    if item.media_type === "movie"
                        div(class="movie" onclick="window.location.href='/movie/' + item.id")
                            img(src="https://image.tmdb.org/t/p/w500" + item.poster_path, alt=item.title)
                            h2= item.title
                            p= item.overview
                            button(type="button", onclick=`addMovieToList('${item.id}')`) Add to List
                    else if item.media_type === "tv"
                        div(class="tv" onclick="window.location.href='/tv/' + item.id")
                            img(src="https://image.tmdb.org/t/p/w500" + item.poster_path, alt=item.name)
                            h2= item.name
                            p= item.overview
                            button(type="button", onclick=`addMovieToList('${item.id}')`) Add to List
                    else if item.media_type === "person"
                        div(class="person" onclick="window.location.href='/person/' + item.id")
                            img(src="https://image.tmdb.org/t/p/w500" + item.profile_path, alt=item.name)
                            h2= item.name
                            p= item.known_for_department
        section(class="filters")
            h2 Filters
            form(action="/searchmovies", method="POST")
                h3 Filter by Type
                input(type="checkbox", name="movie", value="movie")
                label(for="movie") Movie
                input(type="checkbox", name="tv", value="tv")
                label(for="tv") TV Show
                input(type="checkbox", name="person", value="person")
                label(for="person") Person
                br
                h3 Filter by Genre
                input(type="checkbox", name="action", value="28")
                label(for="action") Action
                input(type="checkbox", name="genre", value="12")
                label(for="genre") Adventure
                input(type="checkbox", name="genre", value="16")
                label(for="genre") Cience Fiction
                input(type="checkbox", name="genre", value="35")
                label(for="genre") Comedy
                input(type="checkbox", name="genre", value="80")
                label(for="genre") Crime
                button(type="submit") Apply Filters