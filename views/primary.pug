extends layout.pug

block principal

    section(class="primary")
      div(class="lists")
        checkbox(id="list1", name="list1")
        label(for="list1") List 1
        checkbox(id="list2", name="list2")
        label(for="list2") List 2

      div(class="items")
        h2 Items
        if items
          each item in items
            if item.type === "movie"
                div(class="movie" onclick="window.location.href='/movie/' + item.id")
                    img(src="https://image.tmdb.org/t/p/w500" + item.poster_path, alt=item.title)
                    h2= item.title
                    p= item.overview
            else if item.media_type === "tv"
                div(class="tv" onclick="window.location.href='/tv/' + item.id")
                    img(src="https://image.tmdb.org/t/p/w500" + item.poster_path, alt=item.name)
                    h2= item.name
                    p= item.overview
        else 
          p No items in your list.
        button(type="button", onclick="window.location.href='/search'") Add Items
        

      div(class="filters")
    
    