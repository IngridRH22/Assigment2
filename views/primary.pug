extends layout.pug

block principal

    section(class="generalS")
      aside(class="list-sidebar")
        h2 Lists
        if lists && lists.length
          each list in lists
            - var isOwner = (list.owner && String(list.owner) === String(userid)) || (list.userids && list.userids.userid && String(list.userids.userid) === String(userid))
            div.list-row
              a(href=`/primary?listId=${list._id}`, class=listId && String(listId) === String(list._id) ? "list-btn active" : "list-btn")= list.listName
              button.list-delete(type="button", title=isOwner ? "Delete list" : "Leave list", aria-label=isOwner ? "Delete list" : "Leave list", onclick=`deleteList('${list._id}', ${isOwner})`)= "×"
        else
          p.sidebar-empty No lists yet.
        a(href="/newList", class="list-btn create") + New list

        if selectedList
          section(class="members-panel")
            h3 People
            if members && members.length
              ul.member-list
                each member in members
                  li= member.username
            else
              p.sidebar-empty No members.
            form#addMemberForm
              input(type="hidden", name="listId", value=listId)
              input(type="text", name="username", id="memberUsername", placeholder="Username", required=true)
              button(type="submit") Add person

      div(class="items")
        h2= listName || "My List"
        if !items || items.length === 0
          p No items in your list.
        else
          each item in items
            if item.type === "movie"
              div(class="movie" onclick=`window.location.href='/movie/${item.id}'`)
                img(src="https://image.tmdb.org/t/p/w500" + item.poster_path, alt=item.title)
                h2= item.title
                p= item.overview
                div(class="item-actions" onclick="event.stopPropagation()")
                  div(class="star-rating" data-id=item.id)
                    span.star-label Want to watch
                    each s in [1, 2, 3, 4, 5]
                      button(type="button", class=(item.wantStars || 0) >= s ? "star filled" : "star", onclick=`rateItem('${item.id}', ${s})`, aria-label=`${s} stars`)= "★"
                  button(type="button", class="remove-btn", onclick=`removeMoviefromList('${item.id}')`) Remove
            else if item.type === "tv"
              div(class="tv" onclick=`window.location.href='/tv/${item.id}'`)
                img(src="https://image.tmdb.org/t/p/w500" + item.poster_path, alt=item.name)
                h2= item.name
                p= item.overview
                div(class="item-actions" onclick="event.stopPropagation()")
                  div(class="star-rating" data-id=item.id)
                    span.star-label Want to watch
                    each s in [1, 2, 3, 4, 5]
                      button(type="button", class=(item.wantStars || 0) >= s ? "star filled" : "star", onclick=`rateItem('${item.id}', ${s})`, aria-label=`${s} stars`)= "★"
                  button(type="button", class="remove-btn", onclick=`removeMoviefromList('${item.id}')`) Remove
        button(type="button", class="add-items-btn", onclick="window.location.href='/search'") Add Items

      section(class="filters")
          h2 Filters
          form(action="/primary", method="POST")
              input(type="hidden", name="listId", value=listId)
              h3 Filter by Type
              div
                label
                  input(type="checkbox", name="mediaType", value="movie", checked=mediaType && mediaType.includes("movie"))
                  |  Movie
                label
                  input(type="checkbox", name="mediaType", value="tv", checked=mediaType && mediaType.includes("tv"))
                  |  TV Show
              br
              h3 Filter by Genre
              div
                label
                  input(type="checkbox", name="genres", value="28", checked=genres && genres.includes("28"))
                  |  Action
                label
                  input(type="checkbox", name="genres", value="12", checked=genres && genres.includes("12"))
                  |  Adventure
                label
                  input(type="checkbox", name="genres", value="35", checked=genres && genres.includes("35"))
                  |  Comedy
                label
                  input(type="checkbox", name="genres", value="80", checked=genres && genres.includes("80"))
                  |  Crime
                label
                  input(type="checkbox", name="genres", value="14", checked=genres && genres.includes("14"))
                  |  Fantasy
                label
                  input(type="checkbox", name="genres", value="18", checked=genres && genres.includes("18"))
                  |  Drama
                label
                  input(type="checkbox", name="genres", value="10751", checked=genres && genres.includes("10751"))
                  |  Family
                label
                  input(type="checkbox", name="genres", value="53", checked=genres && genres.includes("53"))
                  |  Thriller
                label
                  input(type="checkbox", name="genres", value="10749", checked=genres && genres.includes("10749"))
                  |  Romance
                label
                  input(type="checkbox", name="genres", value="9648", checked=genres && genres.includes("9648"))
                  |  Mystery
                label
                  input(type="checkbox", name="genres", value="878", checked=genres && genres.includes("878"))
                  |  Science Fiction
              button(type="submit") Apply Filters

    script.
      const currentListId = !{JSON.stringify(listId ? String(listId) : null)};

      async function deleteList(id, isOwner) {
        const message = isOwner
          ? "Delete this list permanently?"
          : "Leave this shared list?";
        if (!confirm(message)) return;
        try {
          const response = await fetch('/deleteList', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ listId: id })
          });
          const data = await response.json();
          if (response.ok && data.success) {
            window.location.href = '/primary';
          } else {
            alert("Error: " + data.message);
          }
        } catch (error) {
          console.error("Network error:", error);
          alert("Could not connect to the server.");
        }
      }

      async function removeMoviefromList(id) {
        try {
          const response = await fetch('/remMoviefromList', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: id, listId: currentListId })
          });
          const data = await response.json();
          if (response.ok && data.success) {
            window.location.reload();
          } else {
            alert("Error: " + data.message);
          }
        } catch (error) {
          console.error("Network error:", error);
          alert("Could not connect to the server.");
        }
      }

      async function rateItem(id, stars) {
        try {
          const response = await fetch('/rateItem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: id, listId: currentListId, stars: stars })
          });
          const data = await response.json();
          if (response.ok && data.success) {
            window.location.reload();
          } else {
            alert("Error: " + data.message);
          }
        } catch (error) {
          console.error("Network error:", error);
          alert("Could not connect to the server.");
        }
      }

      const addMemberForm = document.getElementById('addMemberForm');
      if (addMemberForm) {
        addMemberForm.addEventListener('submit', async function(event) {
          event.preventDefault();
          const username = document.getElementById('memberUsername').value;
          try {
            const response = await fetch('/addMemberToList', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ listId: currentListId, username: username })
            });
            const data = await response.json();
            if (response.ok && data.success) {
              window.location.reload();
            } else {
              alert("Error: " + data.message);
            }
          } catch (error) {
            console.error("Network error:", error);
            alert("Could not connect to the server.");
          }
        });
      }
