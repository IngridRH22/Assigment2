extends layout.pug

block principal

    section(class="login")
      h1 Login
      form(action="/login", method="POST")
        input(type="text", name="username", id="username", required = true, placeholder="Choose a username")
        br
        input(type="password", name="password", id="password", required = true, placeholder="Create a password")
        br
        br
        if error
          p(class="error-messages")= error
        br
        button(type="submit") Login
        button(type="button", onclick="/signin") Sign in
