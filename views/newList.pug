extends layout.pug

block principal

    section(class="newList")
        h1 Create a new list
        form(action="/newList", method="POST")
            input(type="text", name="listName", id="listName", required = true, placeholder="Enter the name of the list")
            br
            button(type="submit") Create List
        form(action="/searchmovies", method="POST")
            input(type="text", name="searchQuery", id="searchQuery", required = true, placeholder="Search for movies to add to your list")
            button(type="submit") Search

        each movie in results
            div(class="movie")
                h2= movie.title
                p= movie.overview
                img(src="https://image.tmdb.org/t/p/w500" + movie.poster_path, alt=movie.title)
                button(type="button", onclick=`addMovieToList('${movie.id}')`) Add to List